{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidock.local/schemas/profile-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "type": [
        "string",
        "null"
      ]
    },
    "plugins": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "skills": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "config_overrides": {
      "type": "object"
    },
    "config_remove": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules_override": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "name"
  ],
  "additionalProperties": false
}
