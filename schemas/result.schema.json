{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidock.local/schemas/result.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "copies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "plan": {
      "type": "string",
      "minLength": 1
    },
    "transaction": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "items": {},
    "recovery": {},
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "ok",
    "code",
    "operation",
    "summary",
    "items",
    "warnings"
  ],
  "additionalProperties": false
}
