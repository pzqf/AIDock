{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidock.local/schemas/plugins-lock.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "definition_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source": {
            "$ref": "defs.schema.json#/$defs/source"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "enum": [
              "windows-amd64",
              "windows-arm64",
              "linux-amd64",
              "linux-arm64",
              "darwin-amd64",
              "darwin-arm64"
            ]
          },
          "entrypoint": {
            "$ref": "defs.schema.json#/$defs/relative"
          },
          "runtime": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "node",
                  "python",
                  "native"
                ]
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "constraint": {
                "type": "string",
                "minLength": 1
              },
              "executable": {
                "$ref": "defs.schema.json#/$defs/relative"
              }
            },
            "required": [
              "kind",
              "version",
              "constraint",
              "executable"
            ],
            "additionalProperties": false
          },
          "artifact": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "defs.schema.json#/$defs/relative"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "entries": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20000,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "$ref": "defs.schema.json#/$defs/relative"
                    },
                    "directory": {
                      "type": "boolean"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 268435456
                    },
                    "mode": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 511
                    }
                  },
                  "required": [
                    "path",
                    "directory",
                    "bytes",
                    "mode"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "path",
              "sha256",
              "entries"
            ],
            "additionalProperties": false
          },
          "resolution": {
            "type": "object",
            "properties": {
              "format": {
                "enum": [
                  "npm-package-lock-v3",
                  "declared"
                ]
              },
              "path": {
                "$ref": "defs.schema.json#/$defs/relative"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "format"
            ],
            "additionalProperties": false
          },
          "dependencies": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "$ref": "defs.schema.json#/$defs/relative"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "resolved": {
                  "type": "string",
                  "minLength": 1
                },
                "integrity": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "name",
                "version",
                "resolved",
                "integrity"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "definition_sha256",
          "source",
          "version",
          "platform",
          "entrypoint",
          "runtime",
          "artifact",
          "resolution",
          "dependencies"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "plugins"
  ],
  "additionalProperties": false
}
