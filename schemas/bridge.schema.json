{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidock.local/schemas/bridge.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "bridges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "defs.schema.json#/$defs/uuid"},
          "project": {"$ref": "defs.schema.json#/$defs/uuid"},
          "scope": {"type": "string", "minLength": 1},
          "copy": {"type": "string", "minLength": 1},
          "root": {"type": "string", "minLength": 1},
          "source_path": {"$ref": "defs.schema.json#/$defs/relative"},
          "source_role": {"const": "external-source"},
          "format": {"const": "native-skill"},
          "generator": {"type": "string", "minLength": 1},
          "packages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {"$ref": "defs.schema.json#/$defs/relative"},
            "uniqueItems": true
          },
          "allow_edit": {"const": false},
          "approved_revision": {"$ref": "defs.schema.json#/$defs/digest"},
          "approved_at": {"type": "string", "format": "date-time"},
          "approved_by": {"type": "string", "minLength": 1}
        },
        "required": ["id", "project", "scope", "copy", "root", "source_path", "source_role", "format"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "bridges"],
  "additionalProperties": false
}
