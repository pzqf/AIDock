{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidock.local/schemas/external-approval.schema.json",
  "type": "object",
  "properties": {
    "approval_id": {"$ref":"defs.schema.json#/$defs/uuid"},
    "binding": {"$ref":"bridge.schema.json#/properties/bridges/items"},
    "package_path": {"$ref":"defs.schema.json#/$defs/relative"},
    "bridge_revision": {"$ref":"defs.schema.json#/$defs/digest"},
    "candidate_revision": {"$ref":"defs.schema.json#/$defs/digest"},
    "approved_at": {"type":"string", "format":"date-time"},
    "skill": {"$ref":"skills.schema.json#/properties/skills/items"}
  },
  "required":["approval_id","binding","package_path","bridge_revision","candidate_revision","approved_at","skill"],
  "additionalProperties":false
}
