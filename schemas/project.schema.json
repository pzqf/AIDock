{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidock.local/schemas/project.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "defs.schema.json#/$defs/uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "group": {
      "type": [
        "string",
        "null"
      ]
    },
    "ai_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rules_sync_mode": {
      "enum": [
        "unidirectional",
        "prompt"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "schema_version",
    "id"
  ],
  "additionalProperties": false
}
