{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidock.local/schemas/inventory.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "project": {
            "$ref": "defs.schema.json#/$defs/uuid"
          },
          "project_name": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "copy": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "$ref": "defs.schema.json#/$defs/relative"
                },
                "role": {
                  "enum": [
                    "owned",
                    "external-source",
                    "generated",
                    "plugin",
                    "unknown"
                  ]
                },
                "generator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "role"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "project",
          "scope",
          "copy",
          "root",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "bindings"
  ],
  "additionalProperties": false
}
