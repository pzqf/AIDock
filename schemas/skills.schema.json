{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidock.local/schemas/skills.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "owner": {
      "anyOf": [
        {
          "enum": [
            "global"
          ]
        },
        {
          "$ref": "defs.schema.json#/$defs/uuid"
        }
      ]
    },
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "defs.schema.json#/$defs/uuid"
          },
          "native_name": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "owned",
                  "external-source",
                  "plugin"
                ]
              },
              "path": {
                "$ref": "defs.schema.json#/$defs/relative"
              },
              "format": {
                "type": "string",
                "minLength": 1
              },
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "plugin_id": {
                "type": "string",
                "minLength": 1
              },
              "lock_digest": {
                "$ref": "defs.schema.json#/$defs/digest"
              }
            },
            "required": [
              "mode",
              "path",
              "format"
            ],
            "additionalProperties": false
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "$ref": "defs.schema.json#/$defs/digest"
          },
          "revision_format": {"const":"semantic-v1"},
          "package_digest": {"$ref":"defs.schema.json#/$defs/digest"},
          "package_format": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "$ref": "defs.schema.json#/$defs/relative"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "type": {
                  "enum": [
                    "text",
                    "binary"
                  ]
                }
              },
              "required": [
                "path",
                "bytes",
                "sha256",
                "type"
              ],
              "additionalProperties": false
            }
          },
          "dependencies": {
            "type": "object",
            "properties": {
              "skills": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "owner": {
                      "anyOf": [
                        {
                          "enum": [
                            "global"
                          ]
                        },
                        {
                          "$ref": "defs.schema.json#/$defs/uuid"
                        }
                      ]
                    },
                    "scope_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "id": {
                      "$ref": "defs.schema.json#/$defs/uuid"
                    },
                    "revision": {
                      "$ref": "defs.schema.json#/$defs/digest"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "owner",
                    "scope_id",
                    "id",
                    "revision",
                    "required"
                  ],
                  "additionalProperties": false
                }
              },
              "plugins": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lock_digest": {
                      "$ref": "defs.schema.json#/$defs/digest"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "lock_digest",
                    "required"
                  ],
                  "additionalProperties": false
                }
              },
              "runtime": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "entrypoint": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "version",
                    "entrypoint",
                    "required"
                  ],
                  "additionalProperties": false
                }
              },
              "project_files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "$ref": "defs.schema.json#/$defs/relative"
                    },
                    "required": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "path",
                    "required"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "compatibility": {
            "type": "object",
            "properties": {
              "platforms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "tools": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "stack": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "project_files": {
                "type": "array",
                "items": {
                  "$ref": "defs.schema.json#/$defs/relative"
                },
                "uniqueItems": true
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "requirements": {
            "type": "object",
            "properties": {
              "fs": {
                "type": "object",
                "properties": {
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "mode": {
                    "enum": [
                      "ro",
                      "rw"
                    ]
                  }
                },
                "required": [
                  "paths",
                  "mode"
                ],
                "additionalProperties": false
              },
              "net": {
                "type": "object",
                "properties": {
                  "allow": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "default": {
                    "enum": [
                      "deny",
                      "allow"
                    ]
                  }
                },
                "required": [
                  "allow",
                  "default"
                ],
                "additionalProperties": false
              },
              "exec": {
                "type": "boolean"
              },
              "scripts": {
                "type": "array",
                "items": {
                  "$ref": "defs.schema.json#/$defs/relative"
                },
                "uniqueItems": true
              },
              "secrets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "base_source": {
            "type": "object",
            "properties": {
              "owner": {
                "anyOf": [
                  {
                    "enum": [
                      "global"
                    ]
                  },
                  {
                    "$ref": "defs.schema.json#/$defs/uuid"
                  }
                ]
              },
              "scope_id": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "$ref": "defs.schema.json#/$defs/uuid"
              }
            },
            "required": [
              "owner",
              "scope_id",
              "id"
            ],
            "additionalProperties": false
          },
          "base_revision": {
            "$ref": "defs.schema.json#/$defs/digest"
          },
          "upstream": {
            "type": "object",
            "properties": {
              "owner": {
                "anyOf": [
                  {
                    "enum": [
                      "global"
                    ]
                  },
                  {
                    "$ref": "defs.schema.json#/$defs/uuid"
                  }
                ]
              },
              "scope_id": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "$ref": "defs.schema.json#/$defs/uuid"
              },
              "revision": {
                "$ref": "defs.schema.json#/$defs/digest"
              }
            },
            "required": [
              "owner",
              "scope_id",
              "id",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "native_name",
          "source",
          "revision",
          "package_format",
          "files",
          "dependencies",
          "compatibility",
          "requirements"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "owner",
    "scope_id",
    "skills"
  ],
  "additionalProperties": false
}
